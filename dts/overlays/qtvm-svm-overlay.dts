					required-subnodes-dsp = <0x53 0x54>;
					reg = <0x00 0x00 0x00 0x00>;
					required-subnodes = <0x12 0x13 0x14 0x11 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27>;
					required-subnodes-rm = <0x28 0x29 0x2a 0x2b 0x2c>;
					phandle = <0x01>;
				};

				clock-controller@100000 {
					compatible = "qcom,dummycc";
					clock-output-names = "gcc_clocks";
					#clock-cells = <0x01>;
					#reset-cells = <0x01>;
					phandle = <0x35>;
				};

				vm-tlmm-irq@0 {
					compatible = "qcom,tlmm-vm-irq";
					reg = <0x00 0x00 0x00 0x00>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x02>;
				};

				qcom,wdt@17600000 {
					compatible = "qcom,msm-watchdog";
					reg = <0x00 0x17600000 0x00 0x1000>;
					reg-names = "wdt-base";
					interrupts = <0x00 0x3a0 0x04 0x00 0x3a1 0x04>;
					qcom,bark-time = <0x2af8>;
					qcom,pet-time = <0x2490>;
					qcom,ipi-ping;
					qcom,wakeup-enable;
					phandle = <0x03>;
				};

				pinctrl@f000000 {
					compatible = "qcom,canoe-vm-tlmm";
					reg = <0x00 0xf000000 0x00 0x202000>;
					interrupts-extended = <0x02 0x01 0x04>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					gpios = <0x560057 0x610062 0x300031 0x320033 0x9e0042 0x640008 0x9000a 0xb0058>;
					required-subnodes = <0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33>;
					phandle = <0x04>;

					qupv3_se1_7i2c_pins {
						phandle = <0x2d>;

						qupv3_se1_7i2c_active {
							phandle = <0x2e>;

							mux {
								pins = "gpio8";
								function = "qup3_se1_l0";
								phandle = <0x2f>;
							};

							config {
								pins = "gpio8";
								drive-strength = <0x02>;
								bias-pull-up;
								phandle = <0x30>;
							};
						};

						qupv3_se1_7i2c_sleep {
							phandle = <0x31>;

							mux {
								pins = "gpio8";
								function = "gpio";
								phandle = <0x32>;
							};

							config {
								pins = "gpio8";
								drive-strength = <0x02>;
								phandle = <0x33>;
							};
						};
					};

					pmx_sde {
						phandle = <0xac>;

						sde_dsi_active {
							phandle = <0xf5>;

							mux {
								phandle = <0xa0>;
								function = "gpio";
								pins = "gpio98";
							};

							config {
								phandle = <0x5a>;
								bias-disable = <0x00>;
								drive-strength = <0x08>;
								pins = "gpio98";
							};
						};

						sde_dsi_suspend {
							phandle = <0xf6>;

							mux {
								phandle = <0xa1>;
								function = "gpio";
								pins = "gpio98";
							};

							config {
								phandle = <0x5b>;
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio98";
							};
						};

						sde_dsi1_active {
							phandle = <0xf3>;

							mux {
								phandle = <0xa2>;
								function = "gpio";
								pins = "gpio97";
							};

							config {
								phandle = <0x5c>;
								bias-disable = <0x00>;
								drive-strength = <0x08>;
								pins = "gpio97";
							};
						};

						sde_dsi1_suspend {
							phandle = <0xf4>;

							mux {
								phandle = <0xa3>;
								function = "gpio";
								pins = "gpio97";
							};

							config {
								phandle = <0x5d>;
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio97";
							};
						};
					};

					pmx_sde_te {
						phandle = <0xae>;

						sde_te_active {
							phandle = <0xfd>;

							mux {
								phandle = <0xa4>;
								function = "mdp_vsync";
								pins = "gpio86";
							};

							config {
								phandle = <0x5e>;
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio86";
							};
						};

						sde_te_suspend {
							phandle = <0xfe>;

							mux {
								phandle = <0xa5>;
								function = "mdp_vsync";
								pins = "gpio86";
							};

							config {
								phandle = <0x5f>;
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio86";
							};
						};

						sde_te_function0 {
							phandle = <0x182>;

							mux {
								function = "gpio";
								pins = "gpio86";
							};

							config {
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio86";
							};
						};

						sde_te1_active {
							phandle = <0xfb>;

							mux {
								phandle = <0xa6>;
								function = "mdp_vsync";
								pins = "gpio87";
							};

							config {
								phandle = <0x60>;
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio87";
							};
						};

						sde_te1_suspend {
							phandle = <0xfc>;

							mux {
								phandle = <0xa7>;
								function = "mdp_vsync";
								pins = "gpio87";
							};

							config {
								phandle = <0x61>;
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio87";
							};
						};

						sde_te1_function0 {
							phandle = <0x183>;

							mux {
								function = "gpio";
								pins = "gpio87";
							};

							config {
								bias-pull-down;
								drive-strength = <0x02>;
								pins = "gpio87";
							};
						};
					};

					pmx_sde_esync {
						phandle = <0xad>;

						sde_esync0_active {
							phandle = <0xf7>;

							mux {
								phandle = <0xa8>;
								function = "mdp_esync0_out";
								pins = "gpio88";
