/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,msm-id = <0x295 0x20000 0x294 0x10000 0x294 0x20000 0x1000294 0x10000 0x295 0x10000 0x1000295 0x10000 0x1000294 0x20000 0x1000295 0x20000>;
	model = "Qualcomm Technologies, Inc. Canoe SVM MTP";
	compatible = "qcom,canoe-mtp\0qcom,canoe\0qcom,canoep-mtp\0qcom,canoep\0qcom,mtp";
	qcom,board-id = <0x08 0x00>;

	host {
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		non-devices-common {
			reg = <0x00 0x00 0x00 0x00>;
			android,pvmfw,target = <0x01>;
		};

		vm-tlmm-irq@0 {
			reg = <0x00 0x00 0x00 0x00>;
			android,pvmfw,target = <0x02>;
		};

		qcom,wdt@17600000 {
			reg = <0x00 0x17600000 0x00 0x1000>;
			android,pvmfw,target = <0x03>;
		};

		pinctrl@f000000 {
			reg = <0x00 0xf000000 0x00 0x202000>;
			android,pvmfw,target = <0x04>;
		};

		qcom,ipcc@1107000 {
			reg = <0x00 0x1107000 0x00 0x1000>;
			android,pvmfw,target = <0x05>;
		};

		qcom,gpi-dma@a00000 {
			reg = <0x00 0xa00000 0x00 0x60000>;
			android,pvmfw,target = <0x06>;
		};

		qcom,qupv3_1_geni_se@ac0000 {
			reg = <0x00 0xac0000 0x00 0x2000>;
			android,pvmfw,target = <0x07>;
		};

		qcom,gpi-dma@1900000 {
			reg = <0x00 0x1900000 0x00 0x60000>;
			android,pvmfw,target = <0x08>;
		};

		qcom,qupv3_3_geni_se@19c0000 {
			reg = <0x00 0x19c0000 0x00 0x2000>;
			android,pvmfw,target = <0x09>;
		};

		qcom,gpi-dma@1a00000 {
			reg = <0x00 0x1a00000 0x00 0x60000>;
			android,pvmfw,target = <0x0a>;
		};

		qcom,qupv3_4_geni_se@1ac0000 {
			reg = <0x00 0x1ac0000 0x00 0x2000>;
			android,pvmfw,target = <0x0b>;
		};

		qcom,gh-qtimer@1781b000 {
			reg = <0x00 0x1781b000 0x00 0x1000>;
			android,pvmfw,target = <0x0c>;
		};

		buffer@81000c000 {
			reg = <0x08 0x1000c000 0x00 0x9000>;
			android,pvmfw,target = <0x0d>;
		};

		buffer@810015000 {
			reg = <0x08 0x10015000 0x00 0x1000>;
			android,pvmfw,target = <0x0e>;
		};

		buffer@810016000 {
			reg = <0x08 0x10016000 0x00 0x1000>;
			android,pvmfw,target = <0x0f>;
		};

		apps-smmu {
			reg = <0x08 0x200000 0x00 0x100000>;
			android,pvmfw,target = <0x10>;
		};

		tlmm-vm-mem-access {
			reg = <0x00 0xf156000 0x00 0x1000 0x00 0xf157000 0x00 0x1000 0x00 0xf162000 0x00 0x1000 0x00 0xf161000 0x00 0x1000 0x00 0xf130000 0x00 0x1000 0x00 0xf131000 0x00 0x1000 0x00 0xf132000 0x00 0x1000 0x00 0xf133000 0x00 0x1000 0x00 0xf1a1000 0x00 0x1000 0x00 0xf1a2000 0x00 0x1000 0x00 0xf164000 0x00 0x1000 0x00 0xf11c000 0x00 0x1000 0x00 0xf11d000 0x00 0x1000 0x00 0xf11e000 0x00 0x1000 0x00 0xf11f000 0x00 0x1000 0x00 0xf158000 0x00 0x1000>;
			android,pvmfw,target = <0x11>;
		};
	};

	qcom,vm-config {
		compatible = "qcom,vm-1.0";
		vm-type = "aarch64-guest";
		boot-config = "fdt,unified";
		os-type = "linux";
		kernel-entry-segment = "kernel";
		kernel-entry-offset = <0x00 0x00>;
		vendor = "QTI";
		image-name = "qcom,trustedvm";
		qcom,pasid = <0x00 0x1c>;
		qcom,qtee-config-info = "p=3,9,C,39,77,78,7C,8F,96,97,C8,FE,10C,11B,159,199,47E,7F1,CDF;";
		qcom,secdomain-ids = <0x2d>;
		qcom,primary-vm-index = <0x00>;
		vm-uri = "vmuid/trusted-ui";
		vm-guid = "598085da-c516-5b25-a9c1-927a02819770";
		vm-attrs = "context-dump\0crash-restart\0no-vpm-aggregation";
		iomemory-ranges = <0x00 0x1107000 0x00 0x1107000 0x00 0x1000 0x00 0x00 0x1924000 0x00 0x1924000 0x00 0x4000 0x00 0x00 0xa24000 0x00 0xa24000 0x00 0x4000 0x00 0x00 0x1a24000 0x00 0x1a24000 0x00 0x4000 0x00>;
		vmmio-ranges;
		gic-irq-ranges = <0x117 0x117 0x369 0x369 0x21d 0x21d 0x271 0x271>;

		segments {
			ramdisk = <0x03>;
			fallback-dtb = <0x02>;
		};

		vcpus {
			affinity = "proxy";
		};

		vdevices {
			generate = "/hypervisor";

			minidump {
				vdevice-type = "minidump";
				push-compatible = "qcom,minidump_rm";
				minidump_allowed;
			};

			rm-rpc {
				vdevice-type = "rm-rpc";
				generate = "/hypervisor/qcom,resource-mgr";
				console-dev;
				message-size = <0xf0>;
				queue-depth = <0x08>;
				qcom,label = <0x01>;
			};

			vrtc {
				vdevice-type = "vrtc-pl031";
				peer-default;
				allocate-base;
			};

			test-dbl-tuivm {
				vdevice-type = "doorbell";
				generate = "/hypervisor/test-dbl-tuivm";
				qcom,label = <0x104>;
				peer-default;
			};

			test-dbl-tuivm-source {
				vdevice-type = "doorbell-source";
				generate = "/hypervisor/test-dbl-tuivm-source";
				qcom,label = <0x104>;
				peer-default;
			};

			test-msgq-tuivm {
				vdevice-type = "message-queue-pair";
				generate = "/hypervisor/test-msgq-tuivm-pair";
				message-size = <0xf0>;
				queue-depth = <0x08>;
				qcom,label = <0x104>;
				peer-default;
			};

			test-large-dmabuf-tuivm {
				vdevice-type = "message-queue-pair";
				generate = "/hypervisor/test-large-dmabuf-tuivm-pair";
				message-size = <0xf0>;
				queue-depth = <0x08>;
				qcom,label = <0x10d>;
				peer-default;
			};

			mem-buf-message-queue-pair {
				vdevice-type = "message-queue-pair";
				generate = "/hypervisor/membuf-msgq-pair";
				message-size = <0xf0>;
				queue-depth = <0x08>;
				peer-default;
				qcom,label = <0x101>;
			};

			msgqsock-msgq {
				vdevice-type = "message-queue-pair";
				generate = "/hypervisor/msgqsock-msgq-pair";
				message-size = <0xf0>;
				queue-depth = <0x08>;
				peer = "vm-name:qcom,oemvm";
				qcom,label = <0x103>;
			};

			smmu-proxy-message-queue-pair {
				vdevice-type = "message-queue-pair";
				generate = "/hypervisor/smmu-proxy-msgq-pair";
				message-size = <0xf0>;
				queue-depth = <0x08>;
				peer-default;
				qcom,label = <0x10a>;
			};

			qrtr-shm {
				vdevice-type = "shm-doorbell";
				generate = "/hypervisor/qrtr-shm";
				push-compatible = "qcom,qrtr-gunyah-gen";
				peer-default;

				memory {
					qcom,label = <0x103>;
					#address-cells = <0x02>;
					base = <0x00 0x6400c000>;
				};
			};

			gpiomem0 {
				vdevice-type = "iomem";
				patch = "/soc/tlmm-vm-mem-access";
				push-compatible = "qcom,tlmm-vm-mem-access";
				peer-default;

				memory {
					qcom,label = <0x08>;
					qcom,mem-info-tag = <0x03>;
					allocate-base;
				};
			};

			ddump-shm {
				vdevice-type = "shm-doorbell";
				generate = "/hypervisor/ddump-shm";
				push-compatible = "qcom,ddump-gunyah-gen";
				peer-default;

				memory {
					qcom,label = <0x107>;
					#address-cells = <0x02>;
					base = <0x00 0x64016000>;
				};
			};

			gunyah-panic-notifier-shm {
				vdevice-type = "shm-doorbell";
				generate = "/hypervisor/gpn-shm";
				push-compatible = "qcom,gunyah-panic-gen";
				peer-default;

				memory {
					qcom,label = <0x109>;
					#address-cells = <0x02>;
					base = <0x00 0x64015000>;
				};
			};
		};
	};

	fragment@0 {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x02>;

			dmesg-dump {
				compatible = "qcom,dmesg-dump";
				gunyah-label = <0x107>;
				ddump-pubkey-size = <0x10e>;
				ddump-pubkey = [30 82 01 0a 02 82 01 01 00 e6 4b 31 82 61 14 f2 be d1 e4 de e7 ed ba 8f 3b 23 5f 7a b8 16 40 96 ae 77 5e 1b f0 3f 39 ab 69 90 b1 d4 70 cb 66 bc 41 08 1d 37 db 49 c8 49 5b 99 5c 32 be 62 d5 a7 3c 0f a4 4b 43 49 db 54 69 06 0c e5 99 e5 f9 1e 25 84 17 47 62 2b 5d 0d ec 5e c6 b5 86 b9 75 6d fe 7d 35 4f 35 c1 48 10 75 4c 57 6b 46 4b ff 5b 52 22 40 2c b0 47 e1 47 c4 e5 47 0c 56 e8 17 d0 7e c3 4d 9f ea d0 ea 87 e5 51 39 e8 45 4c 54 27 9c 50 38 b7 72 93 12 0b a1 2f 9e 04 92 20 6e 31 42 87 e1 fe 88 3f e5 09 e1 f9 be 44 c6 bf 10 79 36 47 7b a0 8e 27 31 a3 70 69 01 54 92 f4 42 bd cd 7e 79 2b 2c e1 d4 ba 6e 34 c6 e6 c6 5c 63 d0 7f 39 1f e8 8d 67 e6 27 67 0d 16 57 94 d1 fb df ce af fd 43 b3 be 5d 83 4b 93 05 e8 df 04 ad ac eb a6 81 a7 d5 04 63 bf 83 b8 0c bc 20 18 b5 50 d7 61 84 11 ca 2d 22 b3 29 02 03 01 00 01];
				phandle = <0x13>;
			};

			firmware {
				phandle = <0x4e>;

				qcom_scm {
					compatible = "qcom,scm-v1.1\0qcom,scm";
					interrupts = <0x00 0x3b1 0x01>;
					qcom,max-queues = <0x23>;
					phandle = <0x12>;
				};
			};

			soc {
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				ranges;
				compatible = "simple-bus";
				phandle = <0x4f>;

