		i2c11 = "/soc/qcom,qupv3_2_geni_se@8c0000/i2c@88c000";
		i2c12 = "/soc/qcom,qupv3_2_geni_se@8c0000/i2c@890000";
		i2c13 = "/soc/qcom,qupv3_3_geni_se@19c0000/i2c@1980000";
