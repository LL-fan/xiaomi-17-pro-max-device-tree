	firmware {
		phandle = <0x393>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x02 0x19000>;
			phandle = <0x277>;
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		qcom_mem_object {
			compatible = "qcom,mem-object";
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};

		sdei {
			compatible = "arm,sdei-1.0";
			method = "hvc";
		};
	};

