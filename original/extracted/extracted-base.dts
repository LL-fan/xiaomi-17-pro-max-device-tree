		idle-states {
			entry-method = "psci";

			medium-cluster0-c4 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				entry-latency-us = <0x5d>;
				exit-latency-us = <0x81>;
				min-residency-us = <0x230>;
				arm,psci-suspend-param = <0x04>;
