	fragment@256 {
		phandle = <0x384>;
		target = <0xffffffff>;

		__overlay__ {

			cirrus_reset_default_0 {
				phandle = <0x33a>;

				mux {
					function = "gpio";
					pins = "gpio10";
				};

				config {
					output-high;
					bias-disable;
					drive-strength = <0x10>;
					pins = "gpio10";
				};
			};

			cirrus_reset_default_1 {
				phandle = <0x33c>;

				mux {
					function = "gpio";
					pins = "gpio54";
				};

				config {
					output-high;
					bias-disable;
					drive-strength = <0x10>;
					pins = "gpio54";
				};
			};

			cirrus_irq_default {

				cirrus_irq_default_0 {
					phandle = <0x33b>;

					mux {
						function = "gpio";
						pins = "gpio11";
					};

					config {
						bias-pull-up;
						input-enable;
						drive-strength = <0x02>;
						pins = "gpio11";
					};
				};

				cirrus_irq_default_1 {
					phandle = <0x33d>;

					mux {
						function = "gpio";
						pins = "gpio47";
					};

					config {
						bias-pull-up;
						input-enable;
						drive-strength = <0x02>;
						pins = "gpio47";
					};
				};
			};

			rcv_gpio_high {
