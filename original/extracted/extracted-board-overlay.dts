					drive-strength = <0x02>;
					pins = "gpio174";
				};
			};

			rcv_gpio_low {
				phandle = <0x33f>;

				mux {
					function = "gpio";
					pins = "gpio174";
				};

				config {
					output-low;
					bias-disable;
					drive-strength = <0x02>;
					pins = "gpio174";
				};
			};

			cirrus_irq_default_2 {
				phandle = <0x341>;

				mux {
					function = "gpio";
					pins = "gpio80";
				};

				config {
					input-enable;
					drive-strength = <0x02>;
					pins = "gpio80";
				};
			};

			cirrus_reset_default2 {
				phandle = <0x340>;

				mux {
					function = "gpio";
					pins = "gpio9";
				};

				config {
					output-high;
					bias-disable;
					drive-strength = <0x10>;
					pins = "gpio9";
				};
			};

			wcd_usbss_reset_active {
				phandle = <0x342>;

				mux {
