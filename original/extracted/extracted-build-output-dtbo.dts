/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Popsicle based on SM8850";
	compatible = "qcom,canoe-mtp\0qcom,canoe\0qcom,canoep-mtp\0qcom,canoep\0qcom,mtp";
	qcom,msm-id = <0x294 0x10000 0x294 0x20000 0x295 0x10000 0x295 0x20000 0x1000294 0x10000 0x1000294 0x20000 0x1000295 0x10000 0x1000295 0x20000>;
	qcom,board-id = <0x08 0x00>;
	xiaomi,miboard-id = <0x01 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			pmk8850@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmk8850";
				};

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					linux,phandle = <0x68>;
					phandle = <0x68>;

					ocp-log@76 {
						reg = <0x76 0x06>;
						linux,phandle = <0x18>;
						phandle = <0x18>;
					};
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					linux,phandle = <0x69>;
					phandle = <0x69>;

					restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						linux,phandle = <0x15>;
						phandle = <0x15>;
					};

					bob1-off-mode-enable@50 {
						reg = <0x50 0x01>;
						linux,phandle = <0x4d>;
						phandle = <0x4d>;
					};

					xo_calib-data@59 {
						reg = <0x59 0x01>;
						linux,phandle = <0x6a>;
						phandle = <0x6a>;
					};

					alarm-log@76 {
						reg = <0x76 0x06>;
						linux,phandle = <0x19>;
						phandle = <0x19>;
					};

					fmd-set@9a {
						reg = <0x9a 0x01>;
						linux,phandle = <0x6b>;
						phandle = <0x6b>;
					};

					fmd_cont_after_pon@9c {
						reg = <0x9c 0x01>;
						linux,phandle = <0x6c>;
						phandle = <0x6c>;
					};

					fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						linux,phandle = <0x6d>;
						phandle = <0x6d>;
					};

					fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						linux,phandle = <0x6e>;
						phandle = <0x6e>;
					};
				};

				sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					linux,phandle = <0x16>;
					phandle = <0x16>;
				};

				sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					linux,phandle = <0x17>;
					phandle = <0x17>;
				};

				sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					linux,phandle = <0x0c>;
					phandle = <0x0c>;
				};

				sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					linux,phandle = <0x0d>;
					phandle = <0x0d>;
				};

				sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					linux,phandle = <0x6f>;
					phandle = <0x6f>;

					sqm-timer@b8 {
						reg = <0xb8 0x02>;
						linux,phandle = <0x11>;
						phandle = <0x11>;
					};
				};

				sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					linux,phandle = <0x14>;
					phandle = <0x14>;
				};

				sdam@aa00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xaa00>;
					linux,phandle = <0x0e>;
					phandle = <0x0e>;
				};

				sdam@ab00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xab00>;
					linux,phandle = <0x0f>;
					phandle = <0x0f>;
				};

				sdam@ac00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xac00>;
					linux,phandle = <0x10>;
					phandle = <0x10>;
				};

				pon_hlos@1300 {
					compatible = "qcom,pmk8350-pon";
					reg = <0x1300 0x800>;
					reg-names = "hlos\0pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};

					pwrkey-bark {
						compatible = "qcom,pmk8350-pwrkey-bark";
						interrupts = <0x00 0x13 0x00 0x03>;
						linux,code = <0x74>;
					};

					pwrkey-resin-bark {
						compatible = "qcom,pmk8350-pwrkey-resin-bark";
						interrupts = <0x00 0x13 0x02 0x03>;
						linux,code = <0x74>;
					};
				};

				sdam@a000 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa000>;
					linux,phandle = <0x05>;
					phandle = <0x05>;
				};

				sdam@a100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa100>;
					linux,phandle = <0x06>;
					phandle = <0x06>;
				};

				sdam@a200 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa200>;
					linux,phandle = <0x07>;
					phandle = <0x07>;
				};

				sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					linux,phandle = <0x70>;
					phandle = <0x70>;

					usb-mode@50 {
						reg = <0x50 0x01>;
						linux,phandle = <0x34>;
						phandle = <0x34>;
					};
				};

				sdam@b700 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb700>;
					linux,phandle = <0x08>;
					phandle = <0x08>;
				};

				pinctrl@b800 {
					compatible = "qcom,pmk8850-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x01>;
					pinctrl-names = "default";
					linux,phandle = <0x71>;
					phandle = <0x71>;

					alt-sleep-clk-default-state {
						pins = "gpio3";
						function = "func1";
						input-disable;
						output-enable;
						power-source = <0x00>;
						linux,phandle = <0x01>;
						phandle = <0x01>;
					};

					lcd-bl-pwm-default-state {
						pins = "gpio5";
						function = "func3";
						input-disable;
						output-enable;
						power-source = <0x00>;
						linux,phandle = <0x72>;
						phandle = <0x72>;
					};

					xoagg-therm-default-state {
						pins = "gpio7";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x02>;
						phandle = <0x02>;
					};
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc\0alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					linux,phandle = <0x73>;
					phandle = <0x73>;
				};

				pmk8850-pwm {
					compatible = "qcom,pmk8850-pwm\0qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				vadc@9000 {
					compatible = "qcom,spmi-adc5-gen4";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					interrupt-names = "adc-sdam0\0adc-sdam1";
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-0 = <0x02 0x03 0x04>;
					pinctrl-names = "default";
					linux,phandle = <0x09>;
					phandle = <0x09>;

					pmk8850_offset_ref {
						reg = <0x00>;
						label = "pmk8850_offset_ref";
					};

					pmk8850_vref_1p25 {
						reg = <0x01>;
						label = "pmk8850_vref_1p25";
					};

					pmk8850_die_temp {
						reg = <0x06>;
						label = "pmk8850_die_temp";
					};

					pmk8850_xoagg_therm {
						reg = <0x11>;
						label = "pmk8850_xoagg_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						linux,phandle = <0x74>;
						phandle = <0x74>;
					};

					pmh0101_offset_ref {
						reg = <0x10000>;
						label = "pmh0101_offset_ref";
					};

					pmh0101_vref_1p25 {
						reg = <0x10001>;
						label = "pmh0101_vref_1p25";
					};

					pmh0101_die_temp {
						reg = <0x10006>;
						label = "pmh0101_die_temp";
					};

					pmh0101_vph_pwr {
						reg = <0x10024>;
						label = "pmh0101_vph_pwr";
					};

					pmh0101_qtm_therm {
						reg = <0x10011>;
						label = "pmh0101_qtm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						linux,phandle = <0x75>;
						phandle = <0x75>;
					};

					pmh0101_pa_therm2 {
						reg = <0x10015>;
						label = "pmh0101_pa_therm_2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0110_d_die_temp {
						reg = <0x30006>;
						label = "pmh0110_d_die_temp";
					};

					pmh0110_d_vph_pwr {
						reg = <0x30024>;
						label = "pmh0110_d_vph_pwr";
					};

					pmh0110_f_die_temp {
						reg = <0x50006>;
						label = "pmh0110_f_die_temp";
					};

					pmh0110_f_vph_pwr {
						reg = <0x50024>;
						label = "pmh0110_f_vph_pwr";
					};

					pmh0110_g_die_temp {
						reg = <0x60006>;
						label = "pmh0110_g_die_temp";
					};

					pmh0110_g_vph_pwr {
						reg = <0x60024>;
						label = "pmh0110_g_vph_pwr";
					};

					pmh0110_i_die_temp {
						reg = <0x80006>;
						label = "pmh0110_i_die_temp";
					};

					pmh0110_i_vph_pwr {
						reg = <0x80024>;
						label = "pmh0110_i_vph_pwr";
					};

					pmih010x_offset_ref {
						reg = <0x1070000>;
						label = "pmih010x_offset_ref";
					};

					pmih010x_vref_1p25 {
						reg = <0x1070001>;
						label = "pmih010x_vref_1p25";
					};

					pmih010x_die_temp {
						reg = <0x1070006>;
						label = "pmih010x_die_temp";
					};

					pmih010x_vph_pwr {
						reg = <0x1070024>;
						label = "pmih010x_vph_pwr";
					};

					pmih010x_vbat_sns_qbg {
						reg = <0x1070023>;
						label = "pmih010x_vbat_sns_qbg";
					};

					pmih010x_iin {
						reg = <0x1070022>;
						label = "pmih010x_iin";
					};

					pmih010x_ichg_fb {
						reg = <0x1070021>;
						label = "pmih010x_ichg_fb";
					};

					pmih010x_chg_temp {
						reg = <0x1070020>;
						label = "pmih010x_chg_temp";
					};

					pmih010x_lite_die_temp {
						reg = <0x1070007>;
						label = "pmih010x_lite_die_temp";
					};

					pmih010x_display_therm {
						reg = <0x1070014>;
						label = "pmih010x_display_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						linux,phandle = <0x76>;
						phandle = <0x76>;
					};

					pmih010x_charger_therm {
						reg = <0x1070013>;
						label = "pmih010x_charger_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						linux,phandle = <0x77>;
						phandle = <0x77>;
					};

					pmh0101_wireless_therm {
						reg = <0x10012>;
						label = "pmh0101_wireless_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						linux,phandle = <0x78>;
						phandle = <0x78>;
					};

					pmh0101_cpu_therm {
						reg = <0x10013>;
						label = "pmh0101_cpu_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmk8850_xo_therm {
						reg = <0x10>;
						label = "pmk8850_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_wifi_therm {
						reg = <0x10012>;
						label = "pmh0101_wifi_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_pa_therm1 {
						reg = <0x10013>;
						label = "pmh0101_pa_therm_1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_quiet_therm {
						reg = <0x10010>;
						label = "pmh0101_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_flash_therm {
						reg = <0x10011>;
						label = "pmh0101_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_batt_therm {
						reg = <0x1070010>;
						label = "pmih010x_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_conn_therm {
						reg = <0x1070013>;
						label = "pmih010x_conn_therm_1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};
				};

				qcom,power-telemetry-device {
					compatible = "qcom,power-telemetry";
					status = "okay";
					interrupts = <0x00 0xa2 0x01 0x01 0x00 0xa1 0x01 0x01>;
					nvmem = <0x05 0x06 0x07>;
					nvmem-names = "qpt-config-sdam\0qpt-frac-sdam\0qpt-data-sdam";
					#powerzone-cells = <0x01>;
					power-domains = <0xffffffff>;
					linux,phandle = <0x1a>;
					phandle = <0x1a>;
				};

				qcom,voltage-adj-device {
					compatible = "qcom,vadj";
					linux,phandle = <0x79>;
					phandle = <0x79>;
				};

				btl {
					compatible = "qcom,btl";
					nvmem = <0x08>;
					nvmem-names = "btl-sdam";
				};

				qcom,power-telemetry-data-share-device {
					compatible = "qcom,power-telemetry-data-share";
				};
			};

			pmh0101@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0101";
				};

				pmh0101-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x09 0x10006>;
					io-channel-names = "thermal";
					linux,phandle = <0x24>;
					phandle = <0x24>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmh0101-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x0a 0x0b>;
					pinctrl-names = "default";
					linux,phandle = <0x47>;
					phandle = <0x47>;

					qtm-therm-default-state {
						pins = "gpio2";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x04>;
						phandle = <0x04>;
					};

					pa-therm2-default-state {
						pins = "gpio3";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x03>;
						phandle = <0x03>;
					};

					cam-sensor-1p8-rst0-active-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-high;
						power-source = <0x00>;
						linux,phandle = <0x7a>;
						phandle = <0x7a>;
					};

					cam-sensor-1p8-rst0-suspend-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-low;
						linux,phandle = <0x7b>;
						phandle = <0x7b>;
					};

					pmh0101-bidir-lvl-shifter1-state {
						pins = "gpio11\0gpio12";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x7c>;
						phandle = <0x7c>;
					};

					pmh0101-bidir-lvl-shifter2-state {
						pins = "gpio13\0gpio14";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x7d>;
						phandle = <0x7d>;
					};

					pmh0101-bidir-lvl-shifter3-state {
						pins = "gpio15\0gpio16";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x7e>;
						phandle = <0x7e>;
					};

					pmh0101-bidir-lvl-shifter4-state {
						pins = "gpio17\0gpio18";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x7f>;
						phandle = <0x7f>;
					};

					wireless_therm-default-state {
						pins = "gpio9";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x0a>;
						phandle = <0x0a>;
					};

					cpu_therm-default-state {
						pins = "gpio12";
						function = "normal";
						bias-high-impedance;
						linux,phandle = <0x0b>;
						phandle = <0x0b>;
					};

					slave_batt_det {

						slave_batt_det_default {
							pins = "gpio1";
							function = "gpio";
							input-enable;
							bias-pull-up;
							linux,phandle = <0x46>;
							phandle = <0x46>;
						};
					};
				};

				led-controller {
					compatible = "qcom,pmh0101-pwm\0qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <0x0c 0x0d>;
					nvmem-names = "lpg_chan_sdam\0lut_sdam";
					linux,phandle = <0x80>;
					phandle = <0x80>;

					led@1 {
						reg = <0x01>;
						color = <0x01>;
						label = "red";
					};

					led@2 {
						reg = <0x02>;
