+	DISP_FEATURE_ROUND_MODE = 31,
+	DISP_FEATURE_GAMUT = 32,
+	DISP_FEATURE_COLORMODE_NOTIFY = 33,
+	DISP_FEATURE_DOLBY_STATUS = 34,
