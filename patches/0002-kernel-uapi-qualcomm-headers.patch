+
+/* feature_id: DISP_FEATURE_FP_STATUS corresponding feature_val */
+enum fingerprint_status {
+	FINGERPRINT_NONE = 0,
+	ENROLL_START = 1,
+	ENROLL_STOP = 2,
+	AUTH_START = 3,
+	AUTH_STOP = 4,
+	HEART_RATE_START = 5,
+	HEART_RATE_STOP = 6,
+};
+
+/* feature_id: DISP_FEATURE_SPR_RENDER corresponding feature_val */
+enum spr_render_status {
+	SPR_1D_RENDERING = 1,
+	SPR_2D_RENDERING = 2,
