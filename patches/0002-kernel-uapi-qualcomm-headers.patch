+	DISP_FEATURE_SPR_RENDER = 15,
+	DISP_FEATURE_AOD_TO_NORMAL = 16,
+	DISP_FEATURE_COLOR_INVERT = 17,
+	DISP_FEATURE_DC_BACKLIGHT = 18,
